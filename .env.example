# Trusted application origin(s) for same-origin POST validation (comma-separated, no trailing slash)
# Required in production; never falls back to arbitrary Host or X-Forwarded-Host headers.
APP_ORIGIN=http://localhost:3000

# External media storage configuration (keep all private media outside Git and public/)
# Local development: STORAGE_DRIVER=local-fs with LOCAL_MEDIA_ROOT outside the repo
# Production (Vercel): STORAGE_DRIVER=vercel-private-blob with connected private Blob store (BLOB_STORE_ID / OIDC or BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER=local-fs
LOCAL_MEDIA_ROOT=D:\leela-archive-media
# BLOB_STORE_ID=

# Authentication secrets (populate in .env.local; never commit real values)
# Run `node scripts/generate-auth-env.mjs` interactively to generate these values.
# - ARCHIVE_PASSPHRASE_HASH format: scrypt:65536:8:2:<saltHex>:<keyHex> (OWASP baseline)
# - ARCHIVE_SESSION_SECRET: 64+ hex characters (minimum 32 random bytes)
# - Sessions are stateless 24-hour HMAC tokens; rotating ARCHIVE_SESSION_SECRET
#   immediately invalidates all active sessions.
# - NOTE: Built-in in-memory rate limiting is development-only. Production deployments
#   must configure platform WAF rate limiting (e.g., Vercel Firewall) or a shared
#   distributed limiter on /api/auth/unlock before launch.
ARCHIVE_PASSPHRASE_HASH=
ARCHIVE_SESSION_SECRET=
