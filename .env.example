# External media storage configuration (keep all personal media outside Git and public/)
STORAGE_DRIVER=local-fs
LOCAL_MEDIA_ROOT=D:\leela-archive-media

# Authentication secrets (populate in .env.local; never commit real values)
# Generate scrypt hash and 32+ byte hex session secret before enabling Phase 1 auth
ARCHIVE_PASSPHRASE_HASH=
ARCHIVE_SESSION_SECRET=
